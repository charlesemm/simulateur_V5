# ÉCHO — modèle du .env de production
#
# À copier sur le serveur en « .env », à côté de compose.prod.yaml, puis à
# remplir. Ce fichier-ci est un modèle : il ne contient aucune vraie valeur
# et peut rester dans le dépôt. Le « .env » rempli, lui, n'y entre jamais.
#
#   cp .env.exemple .env
#   chmod 600 .env
#
# Aucune de ces variables, sauf ECHO_ADMIN_PASSWORD, n'a de valeur par
# défaut dans compose.prod.yaml : s'il en manque une, le lancement échoue en
# la nommant. C'est voulu — un démarrage silencieux sur un mot de passe de
# développement serait pire.

# ── L'image à déployer ───────────────────────────────────────────────
# « latest » suit main et bouge à chaque poussée. Pour une production,
# préférez un repère fixe : « sha-a1b2c3d » ou un tag de version « 1.2.3 ».
# On sait alors exactement quel code tourne, et un retour en arrière se
# résume à remettre l'ancienne valeur ici.
ECHO_IMAGE=ghcr.io/charlesemm/simulateur_v5:latest

# ── Le domaine ───────────────────────────────────────────────────────
# Le nom sous lequel ÉCHO est joignable sur le réseau interne. Il doit
# exister dans le DNS interne (enregistrement A vers l'adresse du serveur)
# avant le premier démarrage — sans quoi personne n'atteindra le service.
#
# Pas d'adresse de courriel ici : elle ne servait qu'à Let's Encrypt, qui
# ne joue aucun rôle dans un déploiement interne (voir le Caddyfile).
ECHO_DOMAINE=echo.ipscnam.ci

# Origines que le navigateur est autorisé à présenter à l'API. Les points
# sont échappés : sans cela « . » vaudrait n'importe quel caractère.
CORS_ORIGIN_REGEX=https://echo\.ipscnam\.ci

# ── Les secrets ──────────────────────────────────────────────────────
# Chacun se génère avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Mot de passe du compte PostgreSQL. Fixé au tout premier démarrage, dans
# le volume « pgdata » : le changer ensuite ici ne change pas celui de la
# base, et l'API ne se connecterait plus. Le choisir une bonne fois.
POSTGRES_PASSWORD=

# Signature des jetons de session. La changer déconnecte tout le monde.
JWT_SECRET_KEY=

# Mot de passe du premier administrateur, lu une seule fois par
# « auth.bootstrap --creer ». À changer depuis l'interface juste après,
# puis cette ligne peut être vidée. Huit caractères minimum.
ECHO_ADMIN_PASSWORD=
