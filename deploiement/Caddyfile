# ÉCHO — configuration Caddy (déploiement INTERNE)
#
# ÉCHO n'est pas exposé sur Internet : il n'est joignable que depuis le
# réseau de l'IPS-CNAM. Cela change une seule chose, mais elle est
# structurante — l'origine du certificat.
#
# Let's Encrypt est hors jeu : il vérifie qu'un domaine vous appartient en
# venant frapper à la porte 80 DEPUIS Internet. Une machine en 10.10.4.165
# n'est pas joignable de là. La demande échouerait indéfiniment.
#
# Le certificat est donc fourni : émis pour le domaine, déposé dans
# « ./certs » sur le serveur, et lu tel quel par Caddy (voir plus bas).
#
# La variable est lue depuis le .env par le compose de production.

{$ECHO_DOMAINE} {
	# ── Le certificat ────────────────────────────────────────────────
	# Le certificat fourni pour ce domaine, et sa clé privée, au format PEM.
	# Ils sont lus dans « ./certs » à côté de ce fichier (montage déclaré
	# dans compose.prod.yaml) et n'entrent jamais dans le dépôt.
	#
	# echo.crt doit contenir le certificat du serveur SUIVI des certificats
	# intermédiaires de l'autorité : sans la chaîne complète, certains
	# navigateurs refusent la connexion alors que d'autres l'acceptent.
	#
	# Caddy ne renouvelle pas un certificat fourni : noter sa date
	# d'expiration, et remplacer les deux fichiers avant (puis redémarrer
	# le conteneur caddy).
	tls /etc/caddy/certs/echo.crt /etc/caddy/certs/echo.key

	# Pour revenir à un certificat signé par Caddy lui-même (dépannage, ou
	# certificat expiré), remplacer la ligne ci-dessus par « tls internal »
	# et redémarrer : les postes afficheront de nouveau un avertissement.

	# ── Ce qui ne passe pas ──────────────────────────────────────────
	# Le témoin n'est appelé que par ÉCHO lui-même, en 127.0.0.1:8000 dans
	# le conteneur (campagnes/echange.py). Ses deux routes sont les seules de
	# l'API sans jeton : rien ne justifie de les offrir au réseau.
	respond /temoin/* 404

	# Aucune route exposée ne reçoit de fichier : les corps sont du JSON de
	# quelques kilo-octets. Le plafond borne ce qu'un envoi peut coûter.
	request_body {
		max_size 10MB
	}

	# ── Le relais vers l'application ─────────────────────────────────
	# « api » est le nom du service dans le compose : Caddy le joint par le
	# réseau interne des conteneurs. Le port 8000 n'est publié nulle part.
	reverse_proxy api:8000

	# Socket.IO (flux temps réel) passe par le même hôte : reverse_proxy
	# relaie la montée en WebSocket de lui-même, rien à déclarer.

	encode gzip zstd

	header {
		# Le navigateur n'essaiera plus jamais ce domaine en clair.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Pas d'interprétation d'un type MIME deviné : un export CSV reste
		# un fichier à télécharger, il ne peut pas être joué comme du HTML.
		X-Content-Type-Options "nosniff"
		# ÉCHO ne s'affiche dans aucun cadre : bloquer le détournement de clic.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le jeton de session vit dans le localStorage du navigateur, et la
		# base contient volontairement des charges XSS (anomalies
		# TENTATIVE_INJECTION). React les échappe ; cette politique reste
		# entre la charge et le jeton si une vue cessait un jour de le faire.
		# Scripts : l'origine seule (Vite compile tout en fichiers). Styles :
		# 'unsafe-inline' pour les styles posés par les bibliothèques, plus
		# Google Fonts, que charge index.html. wss:// pour Socket.IO.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss://{$ECHO_DOMAINE}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# Ne pas annoncer la version du serveur.
		-Server
	}

	log {
		output file /data/acces.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
